VITE_API_TOKEN=chat-interface-token-test
VITE_PRODUCT_ID=infobae
VITE_API_BASE_URL=

# Acceso temporal de la interfaz, validado solo en el navegador:
# admin@infobae.com / infobae-chat
# No lo pongas en variables VITE_*: no protege la API y una autenticación real
# requiere un proveedor o backend. El cliente envía X-Debug: true al enviar
# un mensaje; el backend de desarrollo responde con eventos debug.
